{
  // Terminal > Run Task... (Ctrl+Shift+B runs "build")
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/ShadowAgents.slnx"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/ShadowAgents.slnx"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": ["publish", "${workspaceFolder}/src/ShadowAgents", "-c", "Release"],
      "problemMatcher": "$msCompile"
    }
  ]
}
